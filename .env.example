# AWS account and region for disposable demo resources
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
AWS_ACCOUNT_ID=123456789012

# Harrier MCP endpoint used by validation harnesses
HARRIER_MCP_URL=http://localhost:8000/mcp

# Scenario defaults
RUNTIME=emr_ec2
ROWS=1000
LOG_WAIT_TIMEOUT=420
LOG_POLL_INTERVAL=30

# Optional runtime-specific values
CLUSTER_ID=
EMR_SERVERLESS_APPLICATION_ID=
EMR_SERVERLESS_JOB_ROLE_ARN=
EMR_EKS_CLUSTER_NAME=
EMR_EKS_JOB_ROLE_ARN=

